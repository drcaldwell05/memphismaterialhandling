{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memphismaterialhandling",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "PROJECT_REQUESTS_ENABLED": "true",
    "AOL_COPY_ALERTS_ENABLED": "true",
    "AOL_COPY_TEST_ENABLED": "false",
    "AOL_MONITOR_TEST_ENABLED": "false",
    "MICROSOFT_TENANT_ID": "425c0726-da86-4408-a0c3-acf3cfbc6978",
    "MICROSOFT_CLIENT_ID": "7b354021-f9da-4aa7-9c09-a113ad1194f2",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFFYehKkUgUWD4Of"
  },
  "durable_objects": {
    "bindings": [{ "name": "PROJECT_SUBMISSIONS", "class_name": "ProjectSubmission" }]
  },
  "d1_databases": [{
    "binding": "PROJECT_REQUESTS_DB",
    "database_name": "mmh-project-requests",
    "database_id": "f770b3aa-4ea6-4e4d-b120-cfa978a4bfd7"
  }],
  "migrations": [{ "tag": "project-submission-v1", "new_sqlite_classes": ["ProjectSubmission"] }],
  "ratelimits": [{ "name": "PROJECT_RATE_LIMITER", "namespace_id": "2026092701", "simple": { "limit": 5, "period": 60 } }],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
