{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "memphismaterialhandling",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public"
  },
  "observability": {
    "enabled": true
  }
}
